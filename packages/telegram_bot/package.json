{
  "name": "@eddo/telegram-bot",
  "version": "0.10.1",
  "description": "Telegram bot with MCP server integration for Eddo app",
  "private": true,
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc",
    "dev": "tsx src/index.ts",
    "dev:otel": "OTEL_SERVICE_NAME=eddo-telegram-bot OTEL_RESOURCE_ATTRIBUTES=deployment.environment=development node --import @elastic/opentelemetry-node --import tsx src/index.ts",
    "dev:watch": "tsx watch src/index.ts",
    "start": "node dist/index.js",
    "start:otel": "OTEL_SERVICE_NAME=eddo-telegram-bot OTEL_RESOURCE_ATTRIBUTES=deployment.environment=production node --import @elastic/opentelemetry-node dist/index.js",
    "test": "vitest run",
    "eval:recordings": "tsx src/recording_eval/cli.ts",
    "test:watch": "vitest",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "test:integration:watch": "vitest --config vitest.integration.config.ts"
  },
  "dependencies": {
    "@earendil-works/chord": "1.3.0",
    "@earendil-works/pi-ai": "1.3.0",
    "@earendil-works/pi-durable": "1.3.0",
    "@eddo/core-instrumentation": "workspace:*",
    "@eddo/core-server": "workspace:*",
    "@eddo/core-shared": "workspace:*",
    "@eddo/printer-service": "workspace:*",
    "@eddo/web-api": "workspace:*",
    "@elastic/opentelemetry-node": "^1.8.0",
    "@modelcontextprotocol/client": "^2.3.1",
    "@modelcontextprotocol/sdk": "^1.25.1",
    "@opentelemetry/api": "^1.9.0",
    "dotenv-mono": "^1.5.1",
    "grammy": "^1.46.0",
    "mdast-util-from-markdown": "2.0.2",
    "nano": "^11.0.4",
    "pi-durable-couchdb": "0.0.1",
    "undici": "^8.4.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@modelcontextprotocol/server": "^2.3.1",
    "@testcontainers/couchdb": "^12.2.0",
    "@types/node": "^25.9.3",
    "eslint": "^9.39.2",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3",
    "vite-tsconfig-paths": "^6.1.1",
    "vitest": "^4.1.9"
  },
  "keywords": [
    "telegram",
    "bot",
    "mcp",
    "todo",
    "assistant"
  ],
  "author": "Eddo App",
  "license": "MIT"
}
