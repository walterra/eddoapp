{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "judgments": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "criterion": {
            "enum": [
              "task_fulfillment",
              "claims_grounded_in_results",
              "instruction_compliance",
              "error_recovery",
              "communication_quality"
            ]
          },
          "verdict": {
            "enum": [
              "pass",
              "partial",
              "fail",
              "not_applicable",
              "insufficient_evidence"
            ]
          },
          "explanation": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1500
          },
          "evidenceIds": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "maxItems": 30
          }
        },
        "required": [
          "criterion",
          "verdict",
          "explanation",
          "evidenceIds"
        ],
        "additionalProperties": false
      },
      "minItems": 5,
      "maxItems": 5
    }
  },
  "required": [
    "schemaVersion",
    "judgments"
  ],
  "additionalProperties": false
}
